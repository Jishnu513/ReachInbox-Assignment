# Server
PORT=4000
NODE_ENV=development

# Database (MySQL)
DATABASE_URL="mysql://reachinbox:reachinbox@localhost:3306/reachinbox"

# Redis
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Ethereal Email (SMTP) - run: node -e "require('nodemailer').createTestAccount().then(a => console.log(JSON.stringify(a)))"
ETHEREAL_EMAIL=your@ethereal.email
ETHEREAL_PASS=yourpassword
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587

# BullMQ Worker
WORKER_CONCURRENCY=5

# Rate Limiting
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Min delay between emails (ms) - used as documentation default
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# Frontend URL
FRONTEND_URL=http://localhost:3000
